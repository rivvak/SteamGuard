[Unit]
Description=SteamGuard dev-agent orchestrator (session dispatch, path-guard, PR opener)
After=sg-fcc.service network-online.target
Wants=sg-fcc.service

[Service]
Type=simple
User=sgagent
Group=sgagent
EnvironmentFile=/etc/sg-devbox/env
Environment=PYTHONPATH=/home/sgagent/SteamGuard
WorkingDirectory=/opt/sg-devbox

# Bound to 0.0.0.0 so IAP tunnel from Cloud Run can connect.
# Only IAP source range 35.235.240.0/20 can reach tcp:9090 via allow-iap-sg-devbox firewall rule (target-tags=sg-devbox).
ExecStart=/opt/sg-devbox/venv/bin/uvicorn orchestrator:app \
  --host 0.0.0.0 --port 9090 \
  --workers 1 --log-level info

Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
ProtectHome=false
ProtectSystem=strict
ReadWritePaths=/var/lib/sg-devbox /home/sgagent
PrivateTmp=true

[Install]
WantedBy=multi-user.target
