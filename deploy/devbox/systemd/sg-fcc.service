[Unit]
Description=free-claude-code proxy (Anthropic Messages -> NIM z-ai/glm-5.2)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sgagent
Group=sgagent
EnvironmentFile=/etc/sg-devbox/env
WorkingDirectory=/opt/free-claude-code

# FCC uses pydantic-settings; NVIDIA_NIM_API_KEY is picked up from EnvironmentFile.
# Server binds to 0.0.0.0:8082 by default; the VM has --no-address so this is
# reachable only via IAP tunnel from Cloud Run.
ExecStart=/home/sgagent/.local/bin/uv run fcc-server

Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/sgagent /opt/free-claude-code
PrivateTmp=true

[Install]
WantedBy=multi-user.target
