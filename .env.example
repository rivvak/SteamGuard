# SteamGuard environment variables — copy to .env and fill in real values.
# NEVER commit a filled-in .env. Only this .env.example (placeholders) is tracked.

# ── Loader (loader.py) ────────────────────────────────────────────────────────
# Override the default license/download server (defaults to https://rivvak.app).
SG_SERVER_URL=https://rivvak.app

# ── Server / Cloud Run (server/main.py) ───────────────────────────────────────
SECRET_KEY=your-hmac-signing-key                # must match auth/client.py _HMAC_SECRET
JWT_SECRET=your-jwt-signing-secret
ADMIN_KEY=your-admin-endpoint-key
DISCORD_CLIENT_ID=000000000000000000            # Discord OAuth app client id
DISCORD_CLIENT_SECRET=your-discord-oauth-secret
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
YOUTUBE_CHANNEL_ID=UCxxxxxxxxxxxxxxxxxxxxxx      # optional: channel for sub checks
YOUTUBE_CLIENT_ID=your-google-oauth-client-id   # optional
YOUTUBE_CLIENT_SECRET=your-google-oauth-secret  # optional
MIN_SUPPORTED_VERSION=2.0                        # oldest loader version allowed
APP_VERSION=2.0
STATS_CHANNEL_ID=000000000000000000
OWNER_DISCORD_ID=000000000000000000
ADMIN_USER_IDS=000000000000000000,111111111111111111

# ── Discord bot (server/bot.py) ───────────────────────────────────────────────
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_GUILD_ID=000000000000000000             # Discord server (guild) id
DISCORD_ROLE_ID=000000000000000000              # "Member" role id
DISCORD_INVITE=https://discord.gg/yourinvite
LICENSE_SERVER_URL=https://steamguard-xxxxx.us-central1.run.app
AI_DEVELOP_ENABLED=false
AI_HEAL_ENABLED=false
SG_DEVBOX_NAME=sg-devbox
SG_DEVBOX_ZONE=us-central1-a
SG_DEVBOX_URL=http://127.0.0.1:9090             # local-dev direct override only
AI_DEVBOX_RETRIES=3
AI_DEVBOX_BACKOFF_SECONDS=0.8
GETKEY_CHANNEL_ID=000000000000000000            # #get-key channel
OFF_TOPIC_CHANNEL_ID=000000000000000000
MOD_CHANNEL_ID=000000000000000000
SUPPORT_CHANNEL_ID=000000000000000000
BADGE_ANNOUNCE_CHANNEL_ID=000000000000000000
REFERRAL_INVITE_CHANNEL_ID=000000000000000000
VOTE_TOPICS=topic-one,topic-two
