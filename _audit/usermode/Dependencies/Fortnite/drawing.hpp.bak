// ============================================================================
//  Bullet Tracer System
//  Records shot origin + target, renders fading lines over time
// ============================================================================
struct BulletTracer {
    fvector2d start_screen;
    fvector2d end_screen;
    float spawn_time;
};
static std::deque<BulletTracer> g_tracers;
static auto g_tracerClockStart = std::chrono::steady_clock::now();

float GetTracerTime() {
    auto now = std::chrono::steady_clock::now();
    return std::chrono::duration<float>(now - g_tracerClockStart).count();
}

void AddBulletTracer(fvector2d from, fvector2d to) {
    BulletTracer t;
    t.start_screen = from;
    t.end_screen = to;
    t.spawn_time = GetTracerTime();
    g_tracers.push_back(t);
    while (g_tracers.size() > 64) g_tracers.pop_front();
}

void RenderBulletTracers(float duration, int style) {
    float now = GetTracerTime();
    ImDrawList* dl = ImGui::GetBackgroundDrawList();

    while (!g_tracers.empty() && (now - g_tracers.front().spawn_time) > duration)
        g_tracers.pop_front();

    for (auto& t : g_tracers) {
        float age = now - t.spawn_time;
        float alpha = 1.0f - (age / duration);
        if (alpha <= 0.0f) continue;

        ImU32 col;
        switch (style) {
        case 1: // Fade
            col = IM_COL32(255, 200, 50, (int)(255 * alpha));
            break;
        case 2: { // Gradient yellow->red
            col = IM_COL32(255, (int)(200 * alpha), 50, (int)(255 * alpha));
            break;
        }
        default: // Line
            col = IM_COL32(255, 255, 255, (int)(200 * alpha));
            break;
        }

        // Skip tracers with invalid coordinates
        if (t.end_screen.x < 0 || t.end_screen.y < 0) continue;
        if (t.end_screen.x > 8192 || t.end_screen.y > 8192) continue;

        dl->AddLine(
            ImVec2((float)t.start_screen.x, (float)t.start_screen.y),
            ImVec2((float)t.end_screen.x, (float)t.end_screen.y),
            col, 1.5f
        );
    }
}

// ============================================================================
//  Curved Bezier Skeleton
//  Draws bones as quadratic bezier curves with perpendicular control points
//  Gives organic, natural look instead of straight lines
// ============================================================================
void draw_bezier_bone(ImVec2 a, ImVec2 b, ImColor color, float thickness, float curve_strength) {
    float dx = b.x - a.x;
    float dy = b.y - a.y;
    float len = sqrtf(dx * dx + dy * dy);
    if (len < 1.0f) return;

    float inv_len = 1.0f / len;
    float px = -dy * inv_len;
    float py = dx * inv_len;

    float offset = len * curve_strength;
    ImVec2 ctrl(
        (a.x + b.x) * 0.5f + px * offset,
        (a.y + b.y) * 0.5f + py * offset
    );

    auto dl = ImGui::GetBackgroundDrawList();
    dl->AddBezierQuadratic(a, ctrl, b, ImColor(0, 0, 0, 255), thickness + 1.0f, 12);
    dl->AddBezierQuadratic(a, ctrl, b, color, thickness, 12);
}


void DrawGradientBackground(ImVec2 p1, ImVec2 p2, ImU32 col1, ImU32 col2) {
    ImGui::GetWindowDrawList()->AddRectFilledMultiColor(p1, p2, col1, col2, col2, col1);
}



void RenderTargetGUI(int kills, char teamid, std::string& targetName, const std::string& weaponName, float distance, ImVec2 screenPos) {
    SPOOF_FUNC;

    ImGui::SetNextWindowPos(screenPos, ImGuiCond_Always);
    ImGui::SetNextWindowSize(ImVec2(200, 140), ImGuiCond_Always);

    ImGui::Begin("Target GUI", nullptr, ImGuiWindowFlags_NoTitleBar | ImGuiWindowFlags_NoResize | ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoBackground);

    ImVec2 windowPos = ImGui::GetWindowPos();
    ImVec2 windowSize = ImGui::GetWindowSize();

    ImU32 col1 = ImGui::GetColorU32(ImVec4(0.0353f, 0.1882f, 0.1569f, 0.8f));
    ImU32 col2 = ImGui::GetColorU32(ImVec4(0.1373f, 0.4784f, 0.3412f, 0.8f));

    DrawGradientBackground(windowPos, ImVec2(windowPos.x + windowSize.x, windowPos.y + windowSize.y), col1, col2);

    ImGui::PushStyleVar(ImGuiStyleVar_WindowBorderSize, 0.0f);
    ImGui::PushStyleVar(ImGuiStyleVar_FrameRounding, 10.0f);
    ImGui::PushStyleColor(ImGuiCol_Text, IM_COL32(255, 255, 255, 255));
    ImGui::PushStyleColor(ImGuiCol_Border, IM_COL32(0, 0, 0, 0));
    ImGui::SetCursorPos(ImVec2(10, 10));
    ImGui::Text("Target: %s", targetName.c_str());
    ImGui::SetCursorPos(ImVec2(10, 30));
    ImGui::Text("Weapon: %s", weaponName.c_str());
    ImGui::SetCursorPos(ImVec2(10, 50));
    ImGui::Text("Kills: %d", kills);
    ImGui::SetCursorPos(ImVec2(10, 70));
    ImGui::Text("TeamID: %d", teamid);
    ImGui::SetCursorPos(ImVec2(10, 110));
    ImGui::Text("Distance: %.2fm", distance);

    ImGui::PopStyleColor(2);
    ImGui::PopStyleVar(2);

    ImGui::End();
}

void draw_box1(int x, int y, int w, int h, const ImColor color, ImColor fill_color, int thickness)
{
    auto dl = ImGui::GetBackgroundDrawList();
    if (c_filled_box)
    {
        dl->AddRectFilled(ImVec2(x, y), ImVec2(x + w, y + h), fill_color, 0, 0);
    }
    dl->AddRect(ImVec2(x - 1, y - 1), ImVec2(x + w + 1, y + h + 1), ImColor(0, 0, 0), 0, 0, thickness + 2);
    dl->AddRect(ImVec2(x, y), ImVec2(x + w, y + h), color, 0, 0, thickness);
}

